# Supabase Client (Required)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Admin / Storage (Required for server API routes & storage setup)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Database Direct Connection (Optional: only needed if running local migration scripts in /scripts)
POSTGRES_URL="postgres://postgres.your-project-ref:your-postgres-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider Configuration (Optional - for AI testing features)
# ─────────────────────────────────────────────────────────────────────────────

# Choose your AI provider: omnirouter, openrouter, llma, local, or custom
AI_PROVIDER="omnirouter"

# Provider Base URLs (select based on your AI_PROVIDER choice)
# OmniRouter (recommended - free flagship models)
AI_BASE_URL="https://api.unorouter.com/v1"

# OpenRouter (100+ models)
# AI_BASE_URL="https://openrouter.ai/api/v1"

# LLMA (optimized inference)
# AI_BASE_URL="https://api.llma.io/v1"

# Local LLMs via Ollama or LM Studio (no API key needed)
# AI_BASE_URL="http://localhost:11434/v1"

# Custom OpenAI-compatible endpoint
# AI_BASE_URL="http://localhost:8000/v1"

# API Key (required for remote providers, not needed for local)
# Get free keys at:
# - OmniRouter: https://unorouter.com/token
# - OpenRouter: https://openrouter.ai/keys
# - LLMA: https://llma.io
AI_API_KEY="your_api_key_here"

# Model Selection (choose based on your provider)
# OmniRouter free models:
AI_MODEL="deepseek-v4-flash:free"
# AI_MODEL="gpt-5.5:free"

# OpenRouter models:
# AI_MODEL="anthropic/claude-3.5-sonnet"
# AI_MODEL="google/gemini-2.0-flash-001"
# AI_MODEL="openai/gpt-4o"

# LLMA models:
# AI_MODEL="llma-3.1-70b"

# Local models (Ollama):
# AI_MODEL="llama3.2"
# AI_MODEL="mistral"
# AI_MODEL="deepseek-coder"

# Legacy OpenRouter key (for backward compatibility)
OPENROUTER_API_KEY="your_openrouter_api_key"
