# Supabase Client (Required)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
POSTGRES_URL="postgres://postgres.your-project-ref:your-postgres-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Repository OAuth connections (server-only; never prefix these with NEXT_PUBLIC_)
# Generate a random secret of at least 32 characters for AES-256-GCM token-cookie encryption.
REPOSITORY_CONNECTION_SECRET="replace-with-a-long-random-server-secret"

# GitHub OAuth App callback URL:
# https://YOUR_APP_HOST/api/integrations/github/callback
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# GitLab OAuth application callback URL:
# https://YOUR_APP_HOST/api/integrations/gitlab/callback
# Required scopes are requested by the app: read_user, read_repository, write_repository, api.
GITLAB_OAUTH_CLIENT_ID=""
GITLAB_OAUTH_CLIENT_SECRET=""
GITLAB_BASE_URL="https://gitlab.com"

# GitLab Duo agent execution is a separate provider capability and is not assumed
# to be enabled by repository OAuth alone. Configure a supported agent endpoint
# only after validating the endpoint and auth contract for your GitLab account.
# GITLAB_DUO_AGENT_URL=""
# GITLAB_DUO_AGENT_TOKEN=""

# Default AI provider: Nebius Token Factory + NVIDIA Nemotron
AI_PROVIDER="nebius"
AI_BASE_URL="https://api.tokenfactory.nebius.com/v1"
AI_MODEL="nvidia/Nemotron-3-Nano-Omni"
NEBIUS_API_KEY="your_nebius_token_factory_api_key"
# Alternative accepted server key name:
# NEBIUS_TOKEN_FACTORY_KEY="your_nebius_token_factory_api_key"

# Alternative: OmniRouter / UnoRouter
# AI_PROVIDER="omnirouter"
# AI_BASE_URL="https://api.unorouter.com/v1"
# AI_MODEL="deepseek-v4-flash:free"
# UNOROUTER_API_KEY="your_unorouter_api_key"

# Alternative: local OmniRoute gateway
# AI_PROVIDER="omnirouter"
# AI_BASE_URL="http://localhost:20128/v1"
# AI_MODEL="fast"

# Alternative: local Ollama / LM Studio
# AI_PROVIDER="local"
# AI_BASE_URL="http://localhost:11434/v1"
# AI_MODEL="llama3.2"
